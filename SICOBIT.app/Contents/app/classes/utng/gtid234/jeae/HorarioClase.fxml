<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="640.0" prefWidth="1050.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.HorarioClaseController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="2">
   <Label text="🗓️  Horarios regulares" styleClass="page-title">
      <font><Font name="System Bold" size="22"/></font>
   </Label>
   <Label text="Administra el horario regular de clases (materia y profesor de catálogo), por cuatrimestre" styleClass="page-subtitle"/>
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
</VBox>
</top>

<center>
<VBox spacing="18">

   <VBox spacing="14" styleClass="card">
      <padding><Insets top="20" left="22" right="22" bottom="20"/></padding>

      <Label text="Datos de la clase" styleClass="section-title">
         <font><Font name="System Bold" size="14"/></font>
      </Label>

      <GridPane hgap="18" vgap="12">

         <Label text="Cuatrimestre" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbCuatrimestre" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

         <Label text="Laboratorio" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
         <ComboBox fx:id="cmbLaboratorio" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

         <Label text="Día" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbDia" prefWidth="220" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

         <Label text="Bloque horario" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
         <ComboBox fx:id="cmbBloque" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

         <Label text="Materia" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbMateria" prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

         <Label text="Profesor" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
         <ComboBox fx:id="cmbProfesor" prefWidth="200" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

      </GridPane>

      <Label text="Si el laboratorio ya tiene una clase en ese día/bloque/cuatrimestre, el sistema lo bloqueará y mostrará con qué clase choca." wrapText="true" styleClass="helper-text"/>

      <HBox spacing="12">

         <Button fx:id="btnAgregar" onAction="#agregar" prefHeight="36" prefWidth="130" styleClass="btn, btn-secondary" text="Agregar"/>
         <Button fx:id="btnEditar" onAction="#editar" prefHeight="36" prefWidth="150" styleClass="btn, btn-primary" text="Guardar cambios"/>
         <Button fx:id="btnEliminar" onAction="#eliminar" prefHeight="36" prefWidth="110" styleClass="btn, btn-danger" text="Eliminar"/>
         <Button fx:id="btnLimpiar" onAction="#limpiar" prefHeight="36" prefWidth="110" styleClass="btn, btn-neutral" text="Limpiar"/>

      </HBox>
   </VBox>

   <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
      <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
      <Label text="Clases del cuatrimestre seleccionado, ordenadas por día y bloque." wrapText="true" styleClass="helper-text"/>
      <TableView fx:id="tablaHorario" prefHeight="340" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colDia" text="Día" prefWidth="100"/>
            <TableColumn fx:id="colBloque" text="Bloque" prefWidth="130"/>
            <TableColumn fx:id="colLaboratorio" text="Laboratorio" prefWidth="140"/>
            <TableColumn fx:id="colMateria" text="Materia" prefWidth="200"/>
            <TableColumn fx:id="colProfesor" text="Profesor" prefWidth="180"/>
         </columns>
      </TableView>
   </VBox>

</VBox>
</center>

</BorderPane>
