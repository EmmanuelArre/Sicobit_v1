<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="1050.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.RegistrosAdminController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<HBox alignment="CENTER_LEFT" spacing="16">
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>

   <VBox spacing="2">
      <Label text="📋  Registros de Extraclase" styleClass="page-title">
         <font><Font name="System Bold" size="22"/></font>
      </Label>
      <Label text="Historial de entradas y salidas registradas por los alumnos" styleClass="page-subtitle"/>
   </VBox>

   <Region HBox.hgrow="ALWAYS"/>

   <Label text="Cuatrimestre:" styleClass="field-label"/>
   <ComboBox fx:id="cmbCuatrimestre" prefWidth="220" prefHeight="34"/>

   <Button fx:id="btnRefrescar" onAction="#refrescar" prefHeight="34" prefWidth="120" styleClass="btn, btn-primary" text="⟳  Refrescar"/>
</HBox>
</top>

<center>
<VBox spacing="10" styleClass="card">
   <padding><Insets top="14" left="14" right="14" bottom="14"/></padding>
   <Label text="Historial completo de entradas y salidas de alumnos registradas en actividades extraclase de laboratorio." wrapText="true" styleClass="helper-text"/>
   <TableView fx:id="tablaRegistros" prefHeight="500" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
         <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="100"/>
         <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
         <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="80"/>
         <TableColumn fx:id="colLaboratorio" text="Laboratorio" prefWidth="110"/>
         <TableColumn fx:id="colActividad" text="Actividad" prefWidth="110"/>
         <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
         <TableColumn fx:id="colDia" text="Día" prefWidth="80"/>
         <TableColumn fx:id="colHoraEntrada" text="Entrada" prefWidth="80"/>
         <TableColumn fx:id="colHoraSalida" text="Salida" prefWidth="80"/>
         <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
         <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
      </columns>
   </TableView>
</VBox>
</center>

</BorderPane>
