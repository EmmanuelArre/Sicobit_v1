<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="800.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.ImportarAlumnosController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="2">
   <Label text="📥  Importar alumnos desde Excel" styleClass="page-title">
      <font><Font name="System Bold" size="20"/></font>
   </Label>
   <Label text="El archivo .xlsx debe tener las columnas Matrícula, Nombre y Grupo (con encabezado o en ese orden). Si un grupo no existe se crea; si la matrícula ya existe se actualiza." wrapText="true" styleClass="page-subtitle"/>
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
</VBox>
</top>

<center>
<VBox spacing="14">

   <HBox spacing="12" alignment="CENTER_LEFT">
      <TextField fx:id="txtArchivo" editable="false" promptText="Ningún archivo seleccionado" prefWidth="480" styleClass="field-readonly"/>
      <Button fx:id="btnSeleccionar" onAction="#seleccionarArchivo" prefHeight="34" prefWidth="180" styleClass="btn, btn-neutral" text="Seleccionar archivo..."/>
   </HBox>

   <Label fx:id="lblResumen" text="" wrapText="true" styleClass="status-text"/>

   <TableView fx:id="tablaPreview" VBox.vgrow="ALWAYS" prefHeight="340">
      <columns>
         <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="130"/>
         <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260"/>
         <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="120"/>
         <TableColumn fx:id="colEstado" text="Estado" prefWidth="220"/>
      </columns>
   </TableView>

   <HBox spacing="12" alignment="CENTER_RIGHT">
      <Button fx:id="btnImportar" onAction="#importar" prefHeight="40" prefWidth="160" styleClass="btn, btn-primary" text="Importar"/>
      <Button fx:id="btnCerrar" onAction="#cerrar" prefHeight="40" prefWidth="120" styleClass="btn, btn-neutral" text="Cerrar"/>
   </HBox>

</VBox>
</center>

</BorderPane>
