<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.ReportesController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="14">

   <VBox spacing="2">
      <Label text="📊  Reportes" styleClass="page-title">
         <font><Font name="System Bold" size="22"/></font>
      </Label>
      <Label text="Consulta indicadores generales y exporta la información" styleClass="page-subtitle"/>
   </VBox>

   <HBox alignment="CENTER_LEFT" spacing="14" styleClass="card">
      <padding><Insets top="14" left="18" right="18" bottom="14"/></padding>

      <Label text="Periodo:" styleClass="field-label"/>
      <ComboBox fx:id="cmbPeriodo" prefWidth="160"/>

      <Button fx:id="btnGenerar" onAction="#generar" prefHeight="32" prefWidth="120" styleClass="btn, btn-primary" text="Generar"/>

   </HBox>

</VBox>
</top>

<center>
<ScrollPane fitToWidth="true" styleClass="schedule-scroll">
<VBox spacing="20">
   <padding><Insets top="20"/></padding>

   <HBox spacing="16" alignment="CENTER">

      <VBox alignment="CENTER" spacing="4" prefWidth="160" prefHeight="96" styleClass="stat-card, stat-blue">
         <Label fx:id="lblTotalRegistros" text="0" styleClass="stat-value"><font><Font name="System Bold" size="26"/></font></Label>
         <Label text="Registros" styleClass="stat-label"><font><Font size="12"/></font></Label>
      </VBox>

      <VBox alignment="CENTER" spacing="4" prefWidth="160" prefHeight="96" styleClass="stat-card, stat-orange">
         <Label fx:id="lblTotalIncidencias" text="0" styleClass="stat-value"><font><Font name="System Bold" size="26"/></font></Label>
         <Label text="Incidencias" styleClass="stat-label"><font><Font size="12"/></font></Label>
      </VBox>

      <VBox alignment="CENTER" spacing="4" prefWidth="160" prefHeight="96" styleClass="stat-card, stat-green">
         <Label fx:id="lblTotalPrestamos" text="0" styleClass="stat-value"><font><Font name="System Bold" size="26"/></font></Label>
         <Label text="Préstamos" styleClass="stat-label"><font><Font size="12"/></font></Label>
      </VBox>

      <VBox alignment="CENTER" spacing="4" prefWidth="160" prefHeight="96" styleClass="stat-card, stat-purple">
         <Label fx:id="lblIncidenciasPendientes" text="0" styleClass="stat-value"><font><Font name="System Bold" size="26"/></font></Label>
         <Label text="Pendientes" styleClass="stat-label"><font><Font size="12"/></font></Label>
      </VBox>

      <VBox alignment="CENTER" spacing="4" prefWidth="160" prefHeight="96" styleClass="stat-card, stat-gray">
         <Label fx:id="lblIncidenciasResueltas" text="0" styleClass="stat-value"><font><Font name="System Bold" size="26"/></font></Label>
         <Label text="Resueltas" styleClass="stat-label"><font><Font size="12"/></font></Label>
      </VBox>

   </HBox>

   <VBox spacing="6" styleClass="card">
      <padding><Insets top="14" left="14" right="14" bottom="4"/></padding>
      <Label text="Extraclases registradas por laboratorio" styleClass="section-title">
         <font><Font name="System Bold" size="14"/></font>
      </Label>
      <Label text="Cuántas entradas de extraclase se han registrado en cada laboratorio durante el periodo elegido." wrapText="true" styleClass="helper-text"/>
      <BarChart fx:id="chartExtraclases" prefHeight="280" legendVisible="false">
         <xAxis>
            <CategoryAxis fx:id="ejeXExtraclases" label="Laboratorio"/>
         </xAxis>
         <yAxis>
            <NumberAxis label="Extraclases registradas"/>
         </yAxis>
      </BarChart>
   </VBox>

   <VBox spacing="6" styleClass="card">
      <padding><Insets top="14" left="14" right="14" bottom="4"/></padding>
      <Label text="Préstamos de equipo por laboratorio" styleClass="section-title">
         <font><Font name="System Bold" size="14"/></font>
      </Label>
      <Label text="Cuántos préstamos de equipo de cómputo se han hecho en cada laboratorio durante el periodo elegido." wrapText="true" styleClass="helper-text"/>
      <BarChart fx:id="chartPrestamos" prefHeight="280" legendVisible="false">
         <xAxis>
            <CategoryAxis fx:id="ejeXPrestamos" label="Laboratorio"/>
         </xAxis>
         <yAxis>
            <NumberAxis label="Préstamos de equipo"/>
         </yAxis>
      </BarChart>
   </VBox>

</VBox>
</ScrollPane>
</center>

</BorderPane>
