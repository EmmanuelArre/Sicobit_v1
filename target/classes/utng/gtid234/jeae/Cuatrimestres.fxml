<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="950.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.CuatrimestresController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="2">
   <Label text="📅  Cuatrimestres" styleClass="page-title">
      <font><Font name="System Bold" size="22"/></font>
   </Label>
   <Label text="Marca como activo el cuatrimestre que ven los alumnos al usar el sistema." wrapText="true" styleClass="page-subtitle"/>
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
</VBox>
</top>

<center>
<VBox spacing="18">

   <VBox spacing="14" styleClass="card">
      <padding><Insets top="20" left="22" right="22" bottom="20"/></padding>

      <Label text="Datos del cuatrimestre" styleClass="section-title">
         <font><Font name="System Bold" size="14"/></font>
      </Label>

      <GridPane hgap="18" vgap="12">

         <Label text="Periodo" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cbPeriodo" promptText="Selecciona un periodo" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

         <Label text="Año" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
         <TextField fx:id="txtAnio" promptText="2026" prefWidth="120" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

      </GridPane>

      <Label text="Selecciona un cuatrimestre de la tabla para editarlo, eliminarlo o marcarlo como el activo. Solo puede haber un cuatrimestre activo a la vez; al marcar uno nuevo, el anterior deja de estarlo. Un cuatrimestre con horarios o registros asociados no se podrá eliminar." wrapText="true" styleClass="helper-text"/>

      <HBox spacing="12">

         <Button fx:id="btnAgregar" onAction="#agregar" prefHeight="36" prefWidth="130" styleClass="btn, btn-secondary" text="Agregar"/>
         <Button fx:id="btnGuardarCambios" onAction="#guardarCambios" prefHeight="36" prefWidth="160" styleClass="btn, btn-primary" text="Guardar cambios"/>
         <Button fx:id="btnMarcarActivo" onAction="#marcarActivo" prefHeight="36" prefWidth="160" styleClass="btn, btn-secondary" text="Marcar como activo"/>
         <Button fx:id="btnEliminar" onAction="#eliminar" prefHeight="36" prefWidth="110" styleClass="btn, btn-danger" text="Eliminar"/>
         <Button fx:id="btnLimpiar" onAction="#limpiar" prefHeight="36" prefWidth="110" styleClass="btn, btn-neutral" text="Limpiar"/>

      </HBox>
   </VBox>

   <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
      <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
      <Label text="Cuatrimestres registrados en el sistema. El de la columna 'Activo' en 'Sí' es el que ven los alumnos." wrapText="true" styleClass="helper-text"/>
      <TableView fx:id="tablaCuatrimestres" prefHeight="360" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colPeriodo" text="Periodo" prefWidth="220"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="100"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="100"/>
         </columns>
      </TableView>
   </VBox>

</VBox>
</center>

</BorderPane>
