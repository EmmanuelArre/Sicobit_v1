<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="950.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.MateriasController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="2">
   <Label text="📚  Gestión de Materias" styleClass="page-title">
      <font><Font name="System Bold" size="22"/></font>
   </Label>
   <Label text="Da de alta las materias para poder asignarlas en el horario regular" styleClass="page-subtitle"/>
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
</VBox>
</top>

<center>
<VBox spacing="18">

   <VBox spacing="14" styleClass="card">
      <padding><Insets top="20" left="22" right="22" bottom="20"/></padding>

      <Label text="Datos de la materia" styleClass="section-title">
         <font><Font name="System Bold" size="14"/></font>
      </Label>

      <GridPane hgap="18" vgap="12">

         <Label text="Nombre" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
         <TextField fx:id="txtNombre" promptText="Nombre de la materia" prefWidth="280" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

         <Label text="Estatus" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
         <ComboBox fx:id="cmbEstatus" prefWidth="160" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

      </GridPane>

      <Label text="Solo las materias activas aparecen en el combobox de Horarios regulares." wrapText="true" styleClass="helper-text"/>

      <HBox spacing="12">

         <Button fx:id="btnAgregar" onAction="#agregar" prefHeight="36" prefWidth="130" styleClass="btn, btn-secondary" text="Agregar"/>
         <Button fx:id="btnCambiarEstatus" onAction="#cambiarEstatus" prefHeight="36" prefWidth="160" styleClass="btn, btn-warning" text="Cambiar estatus"/>
         <Button fx:id="btnEliminar" onAction="#eliminar" prefHeight="36" prefWidth="120" styleClass="btn, btn-danger" text="Eliminar"/>
         <Button fx:id="btnLimpiar" onAction="#limpiar" prefHeight="36" prefWidth="110" styleClass="btn, btn-neutral" text="Limpiar"/>

      </HBox>
   </VBox>

   <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
      <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
      <Label text="Materias registradas en el sistema." wrapText="true" styleClass="helper-text"/>
      <TableView fx:id="tablaMaterias" prefHeight="360" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="320"/>
            <TableColumn fx:id="colEstatus" text="Estatus" prefWidth="150"/>
         </columns>
      </TableView>
   </VBox>

</VBox>
</center>

</BorderPane>
