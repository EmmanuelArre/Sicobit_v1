<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="950.0" styleClass="background-app" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid234.jeae.ExportarController">

<padding><Insets top="18" left="22" right="22" bottom="18"/></padding>

<top>
<VBox spacing="2">
   <Label text="📤  Exportación de Datos" styleClass="page-title">
      <font><Font name="System Bold" size="22"/></font>
   </Label>
   <Label text="Selecciona qué información deseas exportar" styleClass="page-subtitle"/>
   <BorderPane.margin><Insets bottom="16"/></BorderPane.margin>
</VBox>
</top>

<center>
<VBox alignment="TOP_CENTER" spacing="24">
   <padding><Insets top="10"/></padding>

   <VBox alignment="TOP_CENTER" spacing="24" maxWidth="560" styleClass="card">
      <padding><Insets top="30" left="34" right="34" bottom="30"/></padding>

      <GridPane hgap="20" vgap="16" maxWidth="500">

         <Label text="Datos a exportar" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbTabla" prefWidth="280" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

         <Label text="Periodo" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbPeriodo" prefWidth="280" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

         <Label text="Formato" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
         <ComboBox fx:id="cmbFormato" prefWidth="280" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

      </GridPane>

      <HBox alignment="CENTER">
         <Button fx:id="btnExportar" onAction="#exportar" prefHeight="44" prefWidth="220" styleClass="btn, btn-secondary" text="📤  Exportar"/>
      </HBox>

      <Label fx:id="lblEstado" text="" styleClass="status-text"/>
   </VBox>

</VBox>
</center>

</BorderPane>
